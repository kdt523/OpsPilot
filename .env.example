# Copy to .env (git-ignored). `make secrets` turns this into Kubernetes Secrets.
OPSPILOT_DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@postgres:5432/opspilot
OPSPILOT_REDIS_URL=redis://redis:6379/0

# --- LLM (Google AI Studio key) ---
OPSPILOT_GEMINI_API_KEY=
OPSPILOT_LLM_PRIMARY_MODEL=gemini-2.5-flash
OPSPILOT_LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
# Keep BELOW the free-tier limits shown in AI Studio (they change over time)
OPSPILOT_LLM_RPM=8
OPSPILOT_LLM_DAILY_CAP=200
OPSPILOT_LLM_THINKING_BUDGET=1024
OPSPILOT_LLM_TEMPERATURE=0.2
# live | record | replay
OPSPILOT_LLM_MODE=live

# --- Agent budgets ---
OPSPILOT_MAX_STEPS=12
OPSPILOT_MAX_TOKENS=60000
OPSPILOT_MAX_SECONDS=120
OPSPILOT_CONFIDENCE_THRESHOLD=0.6

# --- Webhook / endpoints ---
# Bearer token Alertmanager must send (required)
OPSPILOT_WEBHOOK_TOKEN=
OPSPILOT_PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring.svc:9090
OPSPILOT_PROBE_URL=http://opspilot-probe.opspilot.svc:8080
# Comma-separated; tools refuse other namespaces
OPSPILOT_TARGET_NAMESPACES=demo
OPSPILOT_PUBLIC_URL=http://localhost:8080

# --- Slack (optional; Socket Mode) ---
OPSPILOT_SLACK_BOT_TOKEN=
OPSPILOT_SLACK_APP_TOKEN=
OPSPILOT_SLACK_CHANNEL=#incidents

# --- GitHub (optional; fine-grained PAT, Issues read/write) ---
OPSPILOT_GITHUB_TOKEN=
OPSPILOT_GITHUB_REPO=kdt523/opspilot

# --- Behavior ---
# true ONLY in eval mode; policy still denies denied actions
OPSPILOT_AUTO_APPROVE=false
OPSPILOT_VERIFY_SECONDS=180

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=

# --- Optional Langfuse tracing (skipped if unset) ---
OPSPILOT_LANGFUSE_PUBLIC_KEY=
OPSPILOT_LANGFUSE_SECRET_KEY=
OPSPILOT_LANGFUSE_HOST=
